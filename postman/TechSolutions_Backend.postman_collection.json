							"host": ["{{baseUrl}}"],
							"path": ["proyectos", "{{projectId}}"]
						},
						"description": "Esperado: HTTP 200 OK con los campos actualizados."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 200 OK', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Campos actualizados correctamente', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.estado).to.eql('En progreso');",
									"    pm.expect(body.monto).to.eql(5000000);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Actualizar proyecto (PUT)",
