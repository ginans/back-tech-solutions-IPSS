{
	"info": {
		"_postman_id": "tech-solutions-backend",
		"name": "Tech Solutions - Backend",
		"description": "Plan de pruebas para el backend de Tech Solutions (autenticación y gestión de proyectos).\n\nRequisitos previos:\n1. Levantar MySQL: docker compose up -d\n2. Crear tablas: npx prisma db push\n3. (Opcional) Datos estáticos: npm run prisma:seed\n4. Iniciar la API: npm run start:dev\n\nUso:\n- Importar la colección y el entorno en Postman.\n- Seleccionar el entorno \"Tech Solutions - Local\".\n- La variable {{token}} se actualiza automáticamente al ejecutar \"Login\".\n- Ejecutar las pruebas en orden (carpetas).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "projectId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Registro de Usuario",
			"description": "Pruebas del endpoint POST /auth/registro. El controlador cifra la clave con bcrypt antes de almacenarla.",
			"item": [
				{
					"name": "Registro exitoso",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"María González\",\n  \"correo\": \"maria@test.cl\",\n  \"clave\": \"clave123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/registro",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "registro"]
						},
						"description": "Esperado: HTTP 201 Created. Retorna el usuario sin la clave."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 201 Created', () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Mensaje de éxito', () => {",
									"    pm.response.to.have.jsonBody('message', 'Usuario registrado exitosamente');",
									"});",
									"",
									"pm.test('Retorna el usuario con sus campos', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.usuario).to.exist;",
									"    pm.expect(body.usuario.id).to.be.a('number');",
									"    pm.expect(body.usuario.nombre).to.eql('María González');",
									"    pm.expect(body.usuario.correo).to.eql('maria@test.cl');",
									"});",
									"",
									"pm.test('NO debe exponer la clave', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.usuario).to.not.have.property('clave');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Registro con correo duplicado",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"María González\",\n  \"correo\": \"maria@test.cl\",\n  \"clave\": \"clave123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/registro",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "registro"]
						},
						"description": "Ejecutar después de \"Registro exitoso\". Esperado: HTTP 409 Conflict."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 409 Conflict', () => {",
									"    pm.response.to.have.status(409);",
									"});",
									"",
									"pm.test('Mensaje de correo registrado', () => {",
									"    pm.response.to.have.jsonBody('message', 'El correo ya se encuentra registrado');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Registro con datos inválidos (400)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"\",\n  \"correo\": \"correo-invalido\",\n  \"clave\": \"123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/registro",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "registro"]
						},
						"description": "Caso: nombre vacío, correo sin formato válido y clave de menos de 6 caracteres. Esperado: HTTP 400 Bad Request con validaciones."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 400 Bad Request', () => {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test('Incluye mensajes de validación', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.message).to.be.an('array');",
									"    pm.expect(body.message.length).to.be.greaterThan(0);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "2. Inicio de Sesión",
			"description": "Pruebas del endpoint POST /auth/login. Con credenciales correctas retorna un JWT. Este token se guarda automáticamente en la variable {{token}}.",
			"item": [
				{
					"name": "Login exitoso (guarda token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"correo\": \"maria@test.cl\",\n  \"clave\": \"clave123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Esperado: HTTP 200 OK. La respuesta contiene access_token (JWT)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 200 OK', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Retorna un access_token JWT', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.access_token).to.be.a('string');",
									"    const parts = body.access_token.split('.');",
									"    pm.expect(parts.length).to.eql(3);",
									"});",
									"",
									"pm.test('Retorna los datos del usuario sin clave', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.usuario.correo).to.eql('maria@test.cl');",
									"    pm.expect(body.usuario).to.not.have.property('clave');",
									"});",
									"",
									"pm.test('Guarda el token para las siguientes pruebas', () => {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('token', body.access_token);",
									"    pm.expect(pm.collectionVariables.get('token')).to.not.eql('');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Login con clave incorrecta",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"correo\": \"maria@test.cl\",\n  \"clave\": \"clave-incorrecta\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Esperado: HTTP 401 Unauthorized con mensaje 'Credenciales inválidas'."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 401 Unauthorized', () => {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test('Mensaje de credenciales inválidas', () => {",
									"    pm.response.to.have.jsonBody('message', 'Credenciales inválidas');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Login con correo inexistente",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"correo\": \"nadie@test.cl\",\n  \"clave\": \"clave123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Esperado: HTTP 401 Unauthorized."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 401 Unauthorized', () => {",
									"    pm.response.to.have.status(401);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "3. Proyectos - Protección por JWT",
			"description": "Verifica que el middleware (JwtAuthGuard) rechaza peticiones sin token o con token inválido.",
			"item": [
				{
					"name": "Listar proyectos SIN token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/proyectos",
							"host": ["{{baseUrl}}"],
							"path": ["proyectos"]
						},
						"description": "Esperado: HTTP 401 Unauthorized. Demuestra que la ruta está protegida."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 401 Unauthorized sin token', () => {",
									"    pm.response.to.have.status(401);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Listar proyectos con token INVÁLIDO",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer token-invalido-123"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/proyectos",
							"host": ["{{baseUrl}}"],
							"path": ["proyectos"]
						},
						"description": "Esperado: HTTP 401 Unauthorized. El JWT es rechazado por el guard."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 401 con token inválido', () => {",
									"    pm.response.to.have.status(401);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "4. Proyectos - CRUD autenticado",
			"description": "CRUD completo de proyectos usando el token guardado en el Login. Nota: ejecutar primero la carpeta 2 (Login) para tener el {{token}}.",
			"item": [
				{
					"name": "Listar proyectos del usuario",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/proyectos",
							"host": ["{{baseUrl}}"],
							"path": ["proyectos"]
						},
						"description": "Esperado: HTTP 200 OK con un arreglo de proyectos."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 200 OK', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Retorna un arreglo', () => {",
									"    pm.expect(pm.response.json()).to.be.an('array');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Crear proyecto",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"App Móvil Delivery\",\n  \"fechaInicio\": \"2026-08-10\",\n  \"estado\": \"Planificado\",\n  \"responsable\": \"María González\",\n  \"monto\": 4500000\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/proyectos",
							"host": ["{{baseUrl}}"],
							"path": ["proyectos"]
						},
						"description": "Esperado: HTTP 201 Created. Guarda el id en {{projectId}} para las siguientes pruebas."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 201 Created', () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Proyecto creado con todos los campos', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.id).to.be.a('number');",
									"    pm.expect(body.nombre).to.eql('App Móvil Delivery');",
									"    pm.expect(body.estado).to.eql('Planificado');",
									"    pm.expect(body.monto).to.eql(4500000);",
									"    pm.collectionVariables.set('projectId', body.id);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Obtener proyecto por id",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/proyectos/{{projectId}}",
							"host": ["{{baseUrl}}"],
							"path": ["proyectos", "{{projectId}}"]
						},
						"description": "Esperado: HTTP 200 OK con el proyecto creado anteriormente."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 200 OK', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Retorna el proyecto esperado', () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('projectId')));",
									"    pm.expect(body.nombre).to.eql('App Móvil Delivery');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Actualizar proyecto (PATCH)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
