		{
			"name": "5. Seguridad - Acceso cruzado",
			"description": "Verifica que un usuario NO puede ver ni modificar proyectos de otro usuario. Requiere un segundo usuario autenticado.",
			"item": [
				{
					"name": "Login segundo usuario",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"correo\": \"demo@techsolutions.cl\",\n  \"clave\": \"demo123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Inicia sesión con el usuario demo (creado por el seed, tiene proyectos estáticos). Esperado: HTTP 200 OK."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 200 OK', () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Guarda token del segundo usuario', () => {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('demoToken', body.access_token);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "El usuario demo accede a proyecto de María (403)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{demoToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/proyectos/{{projectId}}",
							"host": ["{{baseUrl}}"],
							"path": ["proyectos", "{{projectId}}"]
						},
						"description": "Caso: el proyecto creado por María (projectId) es solicitado con el token del demo. Esperado: HTTP 403 Forbidden (propiedad de datos respetada)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Estado 403 Forbidden', () => {",
									"    pm.response.to.have.status(403);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Proyecto inexistente (404)",
					"request": {
						"method": "GET",
